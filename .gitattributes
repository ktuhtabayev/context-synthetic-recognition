# Text files use LF in the repository and in the working tree on every platform,
# so a checkout never rewrites line endings.
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Protected source material (CLAUDE.md: never modify) is stored byte for byte
docs/handoff/** -text
resources/** -text
# The author's datasets are stored byte for byte: their checksums must not depend on the platform
datasets/** -text
tests/data/** -text

# Experiment workbooks, documents and images are binary (no Git LFS: ADR-014)
*.xlsx binary
*.xls  binary
*.docx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.parquet binary
# Compiled translations of the interface (scripts/update_translations.py)
*.qm   binary
