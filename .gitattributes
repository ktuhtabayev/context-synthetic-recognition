# Text files use LF in the repository and in the working tree on every platform,
# so a checkout never rewrites line endings.
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# The author's datasets, the test workbooks and the experiment's results are stored byte for
# byte: their checksums must not depend on the platform
datasets/** -text
tests/data/** -text
experiments/** -text

# Experiment workbooks, documents and images are binary (no Git LFS: ADR-014)
*.xlsx binary
*.xls  binary
*.docx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.parquet binary
# Compiled translations of the interface (scripts/update_translations.py)
*.qm   binary
